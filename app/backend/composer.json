{
  "name": "workshops-de/bookmonkey-backend",
  "description": "Bookmonkey API - PHP/Slim backend with SQLite for the KI Software Engineer workshop",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "rector/rector": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "Bookmonkey\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bookmonkey\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:8080 -t public",
    "test": "phpunit",
    "seed": "php database/seed.php",
    "migrate": "php database/migrate.php"
  }
}
